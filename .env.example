# Copy to .env and edit. Every variable is described in README.md under "Configuration".
# .env is git-ignored and kept out of the Docker image; put keys here, never in committed files.

# mock (default), civicapi, or json_feed
ELECTION_PROVIDER=civicapi
REFRESH_INTERVAL_SECONDS=30

# Poller schedule (seconds, measured from the start of each fetch)
# POLL_RACES_SECONDS=30
# POLL_OFFICIALS_SECONDS=60
# POLL_EARLY_VOTE_SECONDS=3600

# Official state feeds to cross-check (comma-separated; empty for none)
# OFFICIAL_FEEDS=IA,OH,TX

# civicAPI options
# CIVICAPI_ELECTION_DATE=2026-11-03
# CIVICAPI_RACE_TYPE=US Senate
# CIVICAPI_TEST_DATA=false

# json_feed options (API_KEY is sent as "Authorization: Bearer <key>")
# API_ENDPOINT=https://example.com/races.json
# API_KEY=
